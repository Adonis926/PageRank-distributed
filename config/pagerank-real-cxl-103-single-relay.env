# Equal-resource PageRank profile with one HydraRPC relay per VM.
# PR_SCALE is both the total compute-worker count and total guest-vCPU count.
# At PR_SCALE=16 each VM has 8 workers, 8 vCPUs, 4 GiB, and one relay thread
# sharing CPU 0 with worker 0. Each worker retains an independent shared-memory
# data lane; the single relay multiplexes receive notification and local wakeup.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=pagerank-real-cxl-103-direct-scaling.env
source "$PROFILE_DIR/pagerank-real-cxl-103-direct-scaling.env"

export PR_RECEIVE_MODE=single-relay
export PR_RELAY_CPUS=0
