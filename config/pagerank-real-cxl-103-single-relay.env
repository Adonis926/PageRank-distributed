# Equal-resource PageRank profile with configurable HydraRPC relays per VM.
# PR_SCALE is both the total compute-worker count and total guest-vCPU count.
# At PR_SCALE=16 each VM has 8 workers and 8 vCPUs; the configured relay threads
# share existing worker CPUs. Each worker retains an independent shared-memory
# data lane; relays multiplex receive notification and local wakeup without
# increasing the guest-vCPU budget.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=pagerank-real-cxl-103-direct-scaling.env
source "$PROFILE_DIR/pagerank-real-cxl-103-direct-scaling.env"

export PR_RECEIVE_MODE=shared-relay
export PR_SHARED_RELAYS=${PR_SHARED_RELAYS:-1}
case "$PR_SHARED_RELAYS" in
  1) export PR_RELAY_CPUS=0 ;;
  2) export PR_RELAY_CPUS=0-1 ;;
  4) export PR_RELAY_CPUS=0-3 ;;
  8) export PR_RELAY_CPUS=0-7 ;;
  *) echo "PR_SHARED_RELAYS must be one of 1,2,4,8" >&2; return 2 ;;
esac
