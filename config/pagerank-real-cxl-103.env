# PageRank motivation experiment profile for 10.0.16.103.
# This file is data only.  It never starts a VM or clears DAX.

export PR_HOST_REPO=/home/xtl/cxlfork/mr-pagerank
export PR_HYDRA_ROOT=/home/xtl/cxlfork/HydraRPC-pagerank
export PR_UAPI=/home/xtl/cxlfork/cxlfork-repro/kernel/build-6.6.32/usr/include
export PR_BINARY=/home/xtl/cxlfork/mr-pagerank/build-pagerank/pagerank_hydra
export PR_GUEST_BINARY=/tmp/pagerank_hydra

export PR_VM0_PORT=2200
export PR_VM1_PORT=2201
export PR_VM_WORKSPACE=/home/xtl/cxlfork/cxlfork-repro
export PR_SSH_KEY=/home/xtl/start/hpca-cxlfork/keys/id_ed25519
export PR_ENDPOINT0=/sys/bus/pci/devices/0000:00:02.0/resource2
export PR_ENDPOINT1=/sys/bus/pci/devices/0000:00:03.0/resource2

# HydraRPC payload stays in the shared DAX endpoints above.  This private
# guest-to-guest link carries only one-byte futex-like wake notifications.
export PR_NOTIFY_CHANNEL=tcp
export PR_NOTIFY_PORT_BASE=17500
export PR_VM0_DATA_IP=192.168.50.10
export PR_VM1_DATA_IP=192.168.50.11
export PR_VM0_DATA_MAC=52:54:00:12:01:01
export PR_VM1_DATA_MAC=52:54:00:12:01:02

export PR_VERTICES_PER_NODE=262144
export PR_DEGREE=16
export PR_REMOTE_DEGREE=2
export PR_ITERATIONS=100
export PR_CHUNKS=32
export PR_THREADS=16
export PR_GUEST_CPUS=0-15
export PR_MAP_SIZE=536870912
export PR_QUEUE_CAPACITY=64
export PR_PAYLOAD_MAX=65536
export PR_TEMPLATE_BASE=0x500000000000
export PR_TEMPLATE_BYTES=67108864
export PR_TIMEOUT_MS=180000
export PR_WARMUPS=1
export PR_RUNS=5

# Apply these overrides before invoking the existing cxlfork-repro VM launcher.
# Together the two guests match the single-VM 32-vCPU/8-GiB budget.
export PR_VM_MEM=4G
export PR_VM_SMP=16
# QEMU places the 4-GiB NVDIMM at 0x180000000 for this 4-GiB guest.
# Keep the first 64 MiB reserved, matching the original 16-GiB profile.
export PR_CXL_PHYS=0x184000000
export PR_CXL_SIZE=0xfb000000
# Required by the native-capable KVM profile used on 103.  Without this,
# secondary vCPUs fault while Linux sends the x2APIC startup IPI.
export PR_GUEST_APPEND_EXTRA=nox2apic
export PR_VM0_HOST_CPUS=0-15
export PR_VM1_HOST_CPUS=48-63
export PR_VM0_MEMORY_NODE=0
export PR_VM1_MEMORY_NODE=1
