# PageRank motivation experiment profile for 10.0.16.103.
# This file is data only.  It never starts a VM or clears DAX.  Prefer the
# CXL-DE superproject layout when this repository is checked out as pagerank/;
# retain the historical Lux paths for existing standalone worktrees.

PAGERANK_SOURCE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CXLDE_ROOT=${CXLDE_ROOT:-$(cd "$PAGERANK_SOURCE_ROOT/.." && pwd)}
if [[ -d $CXLDE_ROOT/cxlfork && -d $CXLDE_ROOT/hydrarpc ]]; then
  PR_DEFAULT_HYDRA_ROOT=$CXLDE_ROOT/hydrarpc
  PR_DEFAULT_UAPI=$CXLDE_ROOT/cxlfork/kernel/build-6.6.32/usr/include
  PR_DEFAULT_QEMU=$CXLDE_ROOT/qemu/build/qemu-system-x86_64
  PR_DEFAULT_VM_WORKSPACE=$CXLDE_ROOT/cxlfork
  PR_DEFAULT_SSH_KEY=$CXLDE_ROOT/runtime/keys/id_ed25519
  PR_DEFAULT_RESULT_ROOT=$CXLDE_ROOT/results/pagerank-cxlfork-hydrarpc
else
  PR_DEFAULT_HYDRA_ROOT=/home/xtl/cxlfork/HydraRPC-pagerank
  PR_DEFAULT_UAPI=/home/xtl/cxlfork/cxlfork-repro/kernel/build-6.6.32/usr/include
  PR_DEFAULT_QEMU=/home/xtl/qemu-9.0.90-clean/build/qemu-system-x86_64
  PR_DEFAULT_VM_WORKSPACE=/home/xtl/cxlfork/cxlfork-repro
  PR_DEFAULT_SSH_KEY=/home/xtl/start/hpca-cxlfork/keys/id_ed25519
  PR_DEFAULT_RESULT_ROOT=/home/xtl/cxlfork/results/pagerank-cxlfork-hydrarpc
fi

export PR_HOST_REPO=${PR_HOST_REPO:-$PAGERANK_SOURCE_ROOT}
export PR_HYDRA_ROOT=${PR_HYDRA_ROOT:-$PR_DEFAULT_HYDRA_ROOT}
export PR_UAPI=${PR_UAPI:-$PR_DEFAULT_UAPI}
export PR_BINARY=${PR_BINARY:-$PAGERANK_SOURCE_ROOT/build-pagerank/pagerank_hydra}
export PR_GUEST_BINARY=/tmp/pagerank_hydra

# Keep the virtual platform aligned with:
#   /home/xtl/start/hpca/start-native-vm.sh 32 8 0
# Busy-poll HydraRPC does not require WAITPKG, so use the native qemu64 model.
export PR_QEMU=${PR_QEMU:-$PR_DEFAULT_QEMU}
export PR_MACHINE=pc-i440fx-9.1,kernel-irqchip=split,mem-merge=off
export PR_CPU_MODEL=qemu64,kvmclock-stable-bit=off
export PR_HYDRA_PCI_BUS=pci.0
export PR_HYDRA0_PCI_ADDR=0x3
export PR_HYDRA1_PCI_ADDR=0x4

export PR_VM0_PORT=2200
export PR_VM1_PORT=2201
export PR_VM_WORKSPACE=${PR_VM_WORKSPACE:-$PR_DEFAULT_VM_WORKSPACE}
export PR_SSH_KEY=${PR_SSH_KEY:-$PR_DEFAULT_SSH_KEY}
export PR_RESULT_ROOT=${PR_RESULT_ROOT:-$PR_DEFAULT_RESULT_ROOT}
export PR_ENDPOINT0=/sys/bus/pci/devices/0000:00:03.0/resource2
export PR_ENDPOINT1=/sys/bus/pci/devices/0000:00:04.0/resource2

# Cross-OS signal path: a per-worker relay busy-polls HydraRPC's shared queue,
# then wakes the local compute worker with FUTEX_WAKE.
# This preserves HydraRPC as the only cross-VM transport while making the
# target-OS scheduling/wakeup step explicit and measurable.
export PR_NOTIFY=busy

export PR_VERTICES_PER_NODE=262144
export PR_DEGREE=16
export PR_REMOTE_DEGREE=2
export PR_ITERATIONS=100
export PR_CHUNKS=32
export PR_THREADS=16
export PR_GUEST_CPUS=0-15
export PR_RELAY_CPUS=16-31
export PR_MAP_SIZE=536870912
export PR_QUEUE_CAPACITY=64
export PR_PAYLOAD_MAX=65536
export PR_TEMPLATE_BASE=0x500000000000
export PR_TEMPLATE_BYTES=67108864
export PR_TIMEOUT_MS=180000
export PR_WARMUPS=1
export PR_RUNS=5

# Apply these overrides before invoking the existing cxlfork-repro VM launcher.
# Together the two guests match the single-VM 32-vCPU/8-GiB budget.
export PR_VM_MEM=4G
export PR_VM_SMP=32
export PR_VM_SOCKETS=1
export PR_VM_CORES=32
export PR_VM_THREADS=1
export PR_VM_NUMA_NODES=1
# pc-i440fx-9.1 places this 4-GiB NVDIMM at 0x140000000.  Keep the first
# 64 MiB reserved, matching the original profile; the remaining usable range
# is exactly 0xfb000000 bytes.  This address was verified with the QEMU HMP
# `info memory-devices` command on both VMs.
export PR_CXL_PHYS=0x144000000
export PR_CXL_SIZE=0xfb000000
# Required by the native-capable KVM profile used on 103.  Without this,
# secondary vCPUs fault while Linux sends the x2APIC startup IPI.
export PR_GUEST_APPEND_EXTRA="nox2apic clocksource=kvm-clock nmi_watchdog=0 irqaffinity=0"
export PR_VM0_HOST_CPUS=0-31
export PR_VM1_HOST_CPUS=48-79
export PR_VM0_MEMORY_NODE=0
export PR_VM1_MEMORY_NODE=1
