# Section 5.2 PageRank strong-scaling profile with a fixed total-vCPU budget.
# PR_SCALE is the total guest-vCPU count across both VMs.  Within each VM we
# reserve one eighth of the vCPUs for shared HydraRPC relays and use the other
# seven eighths for PageRank workers.  Thus 16/32/64 total vCPUs map to 7W+1R,
# 14W+2R, and 28W+4R per VM.  The 8-vCPU boundary cannot represent 7:1 while
# retaining a relay in both VMs, so it uses the nearest valid 3W+1R split.
# Total guest memory stays at 8 GiB.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=pagerank-real-cxl-103-direct-scaling.env
source "$PROFILE_DIR/pagerank-real-cxl-103-direct-scaling.env"

relays_per_vm=$((PR_VM_SMP / 8))
(( relays_per_vm >= 1 )) || relays_per_vm=1
workers_per_vm=$((PR_VM_SMP - relays_per_vm))
if (( workers_per_vm < 1 )); then
  echo "PR_SCALE=$PR_SCALE leaves no PageRank worker after relay reservation" >&2
  return 2
fi

export PR_RECEIVE_MODE=shared-relay
export PR_SHARED_RELAYS=$relays_per_vm
export PR_EXPECTED_RELAY_CPU_POLICY=dedicated
export PR_THREADS=$workers_per_vm
export PR_GUEST_CPUS="0-$((workers_per_vm - 1))"
export PR_RELAY_CPUS="$workers_per_vm-$((PR_VM_SMP - 1))"
export PR_SECTION52_TOTAL_VCPUS=$PR_SCALE

# With two workers per VM at the 8-vCPU scale, 32 chunks leave each DATA
# message a few bytes over HydraRPC's 64-KiB payload ceiling.  Split the same
# contribution data into 64 chunks at this boundary; larger scales retain the
# established 32 chunks per worker.
if (( PR_SCALE == 8 )); then
  export PR_CHUNKS=64
fi

unset workers_per_vm relays_per_vm
