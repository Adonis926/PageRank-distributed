# PageRank strong-scaling profile. PR_SCALE is the total number of compute
# workers across both VMs. Each compute worker retains one dedicated relay
# vCPU. The total guest memory remains 8 GiB (4 GiB per VM).

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=pagerank-real-cxl-103.env
source "$PROFILE_DIR/pagerank-real-cxl-103.env"

PR_SCALE=${PR_SCALE:?set PR_SCALE to 8, 16, 32, 64, or 128}
case "$PR_SCALE" in
  8|16|32|64|128) ;;
  *) echo "PR_SCALE must be one of 8,16,32,64,128" >&2; return 2 ;;
esac

export PR_THREADS=$((PR_SCALE / 2))
export PR_VM_SMP=$PR_SCALE
export PR_VM_CORES=$PR_SCALE
export PR_GUEST_CPUS="0-$((PR_THREADS - 1))"
export PR_RELAY_CPUS="$PR_THREADS-$((PR_SCALE - 1))"
export PR_VM_MEM=4G
export PR_WARMUPS=${PR_SCALE_WARMUPS:-1}
export PR_RUNS=${PR_SCALE_RUNS:-5}
export PR_ALLOW_HOST_CPU_OVERLAP=0
export PR_EXPECTED_HOST_CPU_OVERLAP=0

case "$PR_SCALE" in
  8)
    export PR_VM0_HOST_CPUS=0-7
    export PR_VM1_HOST_CPUS=48-55
    ;;
  16)
    export PR_VM0_HOST_CPUS=0-15
    export PR_VM1_HOST_CPUS=48-63
    ;;
  32)
    export PR_VM0_HOST_CPUS=0-31
    export PR_VM1_HOST_CPUS=48-79
    ;;
  64)
    # All 48 physical cores plus 16 sibling threads from the local socket.
    export PR_VM0_HOST_CPUS=0-47,96-111
    export PR_VM1_HOST_CPUS=48-95,144-159
    ;;
  128)
    # The host has only 192 logical CPUs, while this point needs 256 vCPUs
    # (128 compute + 128 relay). Keep the execution path unchanged and make
    # the unavoidable 64-CPU cross-VM overlap explicit in the manifest.
    export PR_VM0_HOST_CPUS=0-47,96-143,48-63,144-159
    export PR_VM1_HOST_CPUS=48-95,144-191,32-47,128-143
    export PR_ALLOW_HOST_CPU_OVERLAP=1
    export PR_EXPECTED_HOST_CPU_OVERLAP=64
    ;;
esac

export PR_SCALE
