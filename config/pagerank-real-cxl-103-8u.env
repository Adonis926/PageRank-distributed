# 8-vCPU-per-VM PageRank profile for the real-CXL host 10.0.16.103.
# Keep the workload and transport identical to the main profile while scaling
# each guest to four compute workers and four dedicated busy-poll relays.

# shellcheck source=pagerank-real-cxl-103.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/pagerank-real-cxl-103.env"

export PR_THREADS=4
export PR_GUEST_CPUS=0-3
export PR_RELAY_CPUS=4-7

export PR_VM_MEM=4G
export PR_VM_SMP=8
export PR_VM_SOCKETS=1
export PR_VM_CORES=8
export PR_VM_THREADS=1
export PR_VM_NUMA_NODES=1

export PR_VM0_HOST_CPUS=0-7
export PR_VM1_HOST_CPUS=48-55
