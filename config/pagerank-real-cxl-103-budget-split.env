# Fixed 32-vCPU PageRank profile with explicit compute/relay partitioning.
# Each VM always has 16 vCPUs and 4 GiB. PR_WORKERS_PER_VM selects either
# 12 compute workers + 4 dedicated shared relays, or 8 + 8. Relay CPUs are
# disjoint from worker CPUs, so no runtime thread is oversubscribed.

PROFILE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=pagerank-real-cxl-103-direct-scaling.env
source "$PROFILE_DIR/pagerank-real-cxl-103-direct-scaling.env"

PR_WORKERS_PER_VM=${PR_WORKERS_PER_VM:?set PR_WORKERS_PER_VM to 12 or 8}
case "$PR_WORKERS_PER_VM" in
  12)
    export PR_SHARED_RELAYS=4
    export PR_GUEST_CPUS=0-11
    export PR_RELAY_CPUS=12-15
    ;;
  8)
    export PR_SHARED_RELAYS=8
    export PR_GUEST_CPUS=0-7
    export PR_RELAY_CPUS=8-15
    ;;
  *) echo "PR_WORKERS_PER_VM must be 12 or 8" >&2; return 2 ;;
esac

export PR_THREADS=$PR_WORKERS_PER_VM
export PR_RECEIVE_MODE=shared-relay
export PR_EXPECTED_RELAY_CPU_POLICY=dedicated
